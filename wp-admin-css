:root {
    --admin-border-radius: 12px;
    --admin-box-shadow: 0px 0px 4px 0px #0000004d;
    --admin-box-shadow: 0rem .3125rem .3125rem -.15625rem rgba(0, 0, 0, .03), 0rem .1875rem .1875rem -.09375rem rgba(0, 0, 0, .02), 0rem .125rem .125rem -.0625rem rgba(0, 0, 0, .02), 0rem .0625rem .0625rem -.03125rem rgba(0, 0, 0, .03), 0rem .03125rem .03125rem 0rem rgba(0, 0, 0, .04), 0rem 0rem 0rem .0625rem rgba(0, 0, 0, .06);
    --admin-padding: 20px;
    --admin-text-clr: #161515;
    --admin-text-clr-light-1: #333333;
    --admin-text-clr-light-2: #666666; 
    --admin-text-clr-dark-1: #1b1a1a;   
    --admin-text-clr-dark-2: #000000;  
    --admin-bg-main: #F1F1F1;
    --admin-bg-color-1: #ebebeb;
    --admin-border-color-dark: #303030;
    --admin-border-color-light: #ebebeb;
    --admin-aside-bg-clr: #EBEBEB;
    --admin-aside-bg-clr-light: #FAFAFA;
    --admin-aside-bg-clr-dark: #FAFAFA;
    --acf-border-color: #ccd0d4;
}

/* admin background  */
body.wp-admin {
    background-color: var(--admin-bg-main);
}


/* admin cards */
.postbox {
    border-radius: var(--admin-border-radius);
    overflow: hidden;
}

.postbox .postbox-header {
    border-bottom-color: var(--admin-border-color-light);
}

/* post title */
#titlewrap input {
    border-radius: var(--admin-border-radius);
    box-shadow: var(--admin-box-shadow);
}

/* admin sidebar  */
#adminmenu {
    background-color: var(--admin-aside-bg-clr);
}

#adminmenu a {
    color: var(--admin-text-clr);
}

/* icon colors  */
#adminmenu div.wp-menu-image:before {
    color: var(--admin-text-clr);
}

#adminmenu a.menu-top {
    background-color: var(--admin-aside-bg-clr-light);
}

#adminmenu .wp-submenu {
    background-color: var(--admin-aside-bg-clr-dark);
}

#adminmenu .wp-submenu li.current a,
#adminmenu .wp-submenu a,
#adminmenu .wp-submenu a:hover, #adminmenu a:hover {
    color: var(--admin-text-clr);
}

/* ACF */
/* --------------------------- */
.acf-tab-wrap.-top {
    overflow: hidden;
}

.acf-tab-group {
    padding: var(--admin-padding);
    
}

.acf-tab-button {
    border-radius: var(--admin-border-radius);
    border-bottom: 1px solid var(--acf-border-color) !important;
}

.acf-postbox .acf-hndle-cog {
    height: 30px;
}
/* --------  ACF END   -------- */
